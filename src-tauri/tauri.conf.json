{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MuffinTwitch",
  "mainBinaryName": "MuffinTwitch",
  "version": "0.4.2",
  "identifier": "dev.nativ.twitchclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MuffinTwitch",
        "width": 1440,
        "height": 860,
        "minWidth": 820,
        "minHeight": 500,
        "backgroundColor": "#0e0e10",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: twproxy: http://twproxy.localhost",
        "media-src": "'self' blob: data: twproxy: http://twproxy.localhost",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost twproxy: http://twproxy.localhost https://7tv.io wss://events.7tv.io https://api.betterttv.net https://recent-messages.robotty.de https://logs.ivr.fi wss://irc-ws.chat.twitch.tv",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "MuffinCody",
    "shortDescription": "Nativer Twitch-Client mit Multiview und Chat",
    "longDescription": "Native Twitch client with multiview, chat with 7TV/BTTV/FFZ emotes, channel points and drops.",
    "category": "Video",
    "homepage": "https://github.com/MuffinCody/MuffinTwitch",
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ],
        "recommends": [
          "gstreamer1-plugin-libav",
          "gstreamer1-plugin-openh264"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "German",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QkJFRjk1MTlGN0MzMzgKUldRNHcvY1psZSs3bG5KODR3TlZIcGJrWXdQMkM1WVArZUt0d3BFVzdKZVZZUWNFY3poalhCRjAK",
      "endpoints": [
        "https://github.com/MuffinCody/MuffinTwitch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
