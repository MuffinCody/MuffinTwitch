{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MuffinTwitch",
  "mainBinaryName": "MuffinTwitch",
  "version": "0.2.0",
  "identifier": "dev.nativ.twitchclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MuffinTwitch",
        "width": 1440,
        "height": 860,
        "minWidth": 820,
        "minHeight": 500,
        "backgroundColor": "#0e0e10",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "MuffinCody",
    "shortDescription": "Nativer Twitch-Client mit Multiview und Chat",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["German", "English"]
      }
    }
  }
}
